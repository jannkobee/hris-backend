DOMAIN=hris.example.com
APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate_show
DB_DATABASE=hris
DB_USERNAME=hris
DB_PASSWORD=replace-with-a-long-random-secret
DB_ROOT_PASSWORD=replace-with-a-different-long-random-secret
MYSQL_IMAGE=mysql:8.4
REDIS_IMAGE=redis:7-alpine
MAIL_MAILER=smtp
MAIL_HOST=replace-me
MAIL_PORT=587
MAIL_USERNAME=replace-me
MAIL_PASSWORD=replace-me
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@hris.example.com
TENANT_BASE_DOMAIN=hris.example.com
