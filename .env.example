APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
CONTENT_SECURITY_POLICY="default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: wss:; media-src 'self' blob:; worker-src 'self' blob:; manifest-src 'self'"
SECURITY_HSTS_ENABLED=false
SECURITY_HSTS_VALUE="max-age=31536000; includeSubDomains"
APP_TIMEZONE=UTC

# Leave TENANT_BASE_DOMAIN empty for local single-host development. In
# production, set it to the tenant host suffix (for example hris.example.com).
TENANT_BASE_DOMAIN=
TENANT_DEFAULT_SLUG=legacy
TENANT_DEFAULT_NAME="Legacy Organization"
TENANT_DEFAULT_TIMEZONE=UTC
TENANT_DEFAULT_COUNTRY_CODE=PH
DEFAULT_ORGANIZATION_PLAN=basic
# The pre-SaaS workspace is adopted as the legacy organization. New customer
# tenants can still be provisioned on Basic.
TENANT_LEGACY_PLAN=enterprise

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hris
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=reverb
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Authentication security
FRONTEND_URL=http://localhost:3000
AUTH_TOKEN_LIFETIME_MINUTES=480
AUTH_MFA_CHALLENGE_MINUTES=5
AUTH_PASSWORD_RESET_MINUTES=60
AUTH_MFA_ISSUER="${APP_NAME}"
OIDC_REDIRECT_URI="${APP_URL}/backend/api/v1/auth/oidc/callback"
OIDC_STATE_MINUTES=10
BILLING_PAST_DUE_GRACE_DAYS=7
BILLING_CURRENCY=usd
STRIPE_PH_STARTER_MONTHLY_CENTAVOS=199000
STRIPE_PH_GROWTH_MONTHLY_CENTAVOS=499000
STRIPE_PH_BUSINESS_MONTHLY_CENTAVOS=1199000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Platform control-plane credential. Keep this only in the backend environment
# or secret manager; never expose it to the tenant-facing SPA.
PLATFORM_PROVISIONING_KEY=
PUBLIC_TRIAL_DAYS=14

# Public holiday provider (Nager.Date-compatible endpoint).
HOLIDAY_PROVIDER_BASE_URL=https://date.nager.at/api/v3
HOLIDAY_PROVIDER_COUNTRY_CODE=PH
HOLIDAY_PROVIDER_TIMEOUT_SECONDS=15

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_PUBLIC_HOST=127.0.0.1
REVERB_PUBLIC_PORT=8080
REVERB_PUBLIC_SCHEME=http

AUDIT_LOG_RETENTION_YEARS=7
AUDIT_LOG_SIGNING_KEY=
OWNER_INVITATION_DAYS=7
OWNER_INVITATION_URL="http://localhost:5173/accept-invite"
BILLING_PORTAL_RETURN_HOSTS=localhost
ORGANIZATION_EXPORT_DISK=local
ORGANIZATION_EXPORT_RETENTION_HOURS=72
SECURITY_HSTS_ENABLED=false
SECURITY_HSTS_VALUE="max-age=31536000; includeSubDomains"

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
